{
  "name": "banking-mcp-resource-server",
  "version": "1.0.0",
  "description": "Config-driven MCP server: one vertical (banking by default) defined by verticals/<name>/{vertical.json,schema.sql,seed.json}",
  "main": "dist/index.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "rm -rf dist && npm run build",
    "dev": "nodemon --exec \"node --experimental-sqlite -r ts-node/register\" src/index.ts",
    "start": "node --experimental-sqlite dist/index.js",
    "test": "jest && node --test scripts/check-forbidden-strings.test.mjs scripts/doctor.test.mjs scripts/compose.test.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "check:forbidden": "node scripts/check-forbidden-strings.mjs"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.59.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.200.0",
    "@opentelemetry/sdk-node": "^0.200.0",
    "dotenv": "^17.2.2",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
